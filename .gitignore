# =============================================================================================
# Generated files that must never be committed
# =============================================================================================

# ---- ALL run logs and captured tool output (any folder) -------------------------------------
# make / vvp / iverilog / sby / yosys / Questa logs, stderr and stdout captures
*.log
*.err
*.out
*.jou
transcript
vsim_stacktrace.vstf
*.vstf

# ---- simulation build products and waveforms (any folder) ----------------------------------
*.vvp
*.vcd
*.fst
*.wlf
*.cr.mti

# ---- build / result directories --------------------------------------------------------------
# "make" output: binaries, per-test logs (sim/build/log), mutation-check copies
sim/build/
# Questa / ModelSim work library (regenerated by sim/run_compile.do)
sim/work/
# SymbiYosys result directories (formal/fv_*_run)
formal/*_run/

# ---- python / editor -------------------------------------------------------------------------
__pycache__/
*.pyc
*.bak
