# =============================================================================================
# Generated files that must never be committed
# =============================================================================================

# ---- ALL run logs and captured tool output (any folder) -------------------------------------
# make / vvp / iverilog / sby / yosys / Questa logs, stderr and stdout captures
*.log
*.err
*.out
*.jou
transcript
vsim_stacktrace.vstf
*.vstf

# ---- simulation build products and waveforms (any folder) ----------------------------------
*.vvp
*.vcd
*.fst
*.wlf
*.cr.mti

# ---- build / result directories --------------------------------------------------------------
# Single-block AES-128 simulation products and formal work directories.
verification/single_aes128/sim/build/
verification/single_aes128/sim/work/
verification/single_aes128/formal/*_run/
# High-throughput AES-128 and dual-key build products.
verification/ht_aes128/build/
verification/ht_aes128_256/build/

# ---- python / editor -------------------------------------------------------------------------
__pycache__/
*.pyc
*.bak

# Keep per-design synthesis / lint logs and reviewable simulation evidence.
!verification/ht_aes128/logs/*.log
!verification/ht_aes128/reports/*.log
!verification/ht_aes128/waveforms_sim/*.vcd
!verification/ht_aes128_256/logs/*.log
!verification/ht_aes128_256/reports/*.log
!verification/ht_aes128_256/waveforms_sim/*.vcd
